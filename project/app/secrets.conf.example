# Deployment-specific credentials — kept out of version control.
#
# Copy this file to secrets.conf (same directory) and fill in the values.
# The justfile passes it to the build via EXTRA_CONF_FILE.

# MQTT broker instance and per-device password
CONFIG_MQTT_SAMPLE_TRANSPORT_BROKER_HOSTNAME="<broker>.s1.eu.hivemq.cloud"
CONFIG_MQTT_SAMPLE_TRANSPORT_BROKER_PASSWORD="<device password>"

# Memfault project key (Settings -> Project Key in the Memfault dashboard)
CONFIG_MEMFAULT_NCS_PROJECT_KEY="<memfault project key>"
