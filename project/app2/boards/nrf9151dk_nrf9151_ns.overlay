/*
 * Overlay for the Nordic nRF9151 DK (app2).
 *
 * Adds the AnchorLink test hardware plus the air-quality sensor wired to the DK:
 *   - i2c2: SDA = P0.06, SCL = P0.07 (SERIAL1 is reserved by TF-M, so i2c2 is used)
 *   - Sensirion SEN66 air-quality sensor @ 0x6B (accessed via raw I2C)
 *
 * The relay/sense/ADC pins are arbitrary placeholders (nothing wired).
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	relays {
		compatible = "gpio-leds";
		relay0: relay_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "REL0_EN";
		};
		relay1: relay_1 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "REL1_EN";
		};
	};

	sense_enables {
		compatible = "gpio-leds";
		vbat_en: vbat_en {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "VBAT_SENSE_EN";
		};
		vbat2_en: vbat2_en {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "VBAT2_SENSE_EN";
		};
		ignition_en: ignition_en {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "IGNITION_SENSE_EN";
		};
	};

	zephyr,user {
		/* ADC channels: 0=REL0_SENSE, 1=REL1_SENSE, 2=VBAT_SENSE, 3=VBAT2_SENSE, 4=IGNITION_SENSE */
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>;
	};

	aliases {
		relay0 = &relay0;
		relay1 = &relay1;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};
};

/*
 * Use i2c2 (SERIAL2) for the SEN66. SERIAL1 is reserved by TF-M as its secure
 * log UART, so it must not be touched from the non-secure app. i2c2 is already
 * the non-secure arduino_i2c; re-pin it from the arduino header to the wired
 * pins (SDA=P0.06, SCL=P0.07).
 */
&i2c2_default {
	group1 {
		psels = <NRF_PSEL(TWIM_SCL, 0, 7)>,
			<NRF_PSEL(TWIM_SDA, 0, 6)>;
	};
};

&i2c2_sleep {
	group1 {
		psels = <NRF_PSEL(TWIM_SCL, 0, 7)>,
			<NRF_PSEL(TWIM_SDA, 0, 6)>;
		low-power-enable;
	};
};

&i2c2 {
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* SEN66 lives on this bus at 0x6B and is accessed with raw I2C from the
	 * sen66 shell command (no Zephyr binding exists for it). */
};
