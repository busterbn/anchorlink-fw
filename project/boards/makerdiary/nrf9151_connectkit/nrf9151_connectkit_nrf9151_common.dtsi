#include "nrf9151_connectkit_nrf9151_common-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
	model = "Makerdiary nRF9151 Connect Kit nRF9151";
	compatible = "makerdiary,nrf9151-connectkit-nrf9151";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BTN0";
			zephyr,code = <INPUT_KEY_0>;
		};
		button1: button_1 {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BTN1";
			zephyr,code = <INPUT_KEY_1>;
		};
		button2: button_2 {
			gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BTN2";
			zephyr,code = <INPUT_KEY_2>;
		};
	};

	relays {
		compatible = "gpio-leds";
		relay0: relay_0 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "REL0_EN";
		};
		relay1: relay_1 {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "REL1_EN";
		};
	};

	sense_enables {
		compatible = "gpio-leds";
		vbat_en: vbat_en {
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
			label = "VBAT_SENSE_EN";
		};
		vbat2_en: vbat2_en {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
			label = "VBAT2_SENSE_EN";
		};
		ignition_en: ignition_en {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "IGNITION_SENSE_EN";
		};
	};

	zephyr,user {
		/* ADC channels: 0=REL0_SENSE, 1=REL1_SENSE, 2=VBAT_SENSE, 3=VBAT2_SENSE, 4=IGNITION_SENSE.
		 * IGNITION_SENSE (P0.15/AIN2) doubles as the button4 input, read as an
		 * analog threshold since the signal only reaches ~1 V. */
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>;
	};

	aliases {
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		mcuboot-button0 = &button0;
		watchdog0 = &wdt0;
		relay0 = &relay0;
		relay1 = &relay1;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* REL0_SENSE: P0.16 = AIN3 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	/* REL1_SENSE: P0.20 = AIN7 */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	/* VBAT_SENSE: P0.19 = AIN6 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN6>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	/* VBAT2_SENSE: P0.13 = AIN0 */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	/* IGNITION_SENSE: P0.15 = AIN2 */
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x10000>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
		};
		slot0_ns_partition: partition@50000 {
			label = "image-0-nonsecure";
		};
		slot1_partition: partition@85000 {
			label = "image-1";
		};
		slot1_ns_partition: partition@c5000 {
			label = "image-1-nonsecure";
		};
		storage_partition: partition@fa000 {
			label = "storage";
			reg = <0x000fa000 0x00006000>;
		};
	};
};

/ {

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sram0_s: image_s@20000000 {
			/* Secure image memory */
		};

		sram0_modem: image_modem@20016000 {
			/* Modem (shared) memory */
		};

		sram0_ns: image_ns@20020000 {
			/* Non-Secure image memory */
		};
	};
};

/* Include partition configuration file */
#include "nrf9151_connectkit_nrf9151_partition_conf.dtsi"
